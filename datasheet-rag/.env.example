# Copy to .env and fill in. .env is gitignored.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGDATABASE=postgres
PGPASSWORD=

# Which database the code uses: local or aurora. Leave it local here; set DB_TARGET=aurora in the shell
# for a command that should reach Aurora.
DB_TARGET=local

# Aurora (Cycle 2). Identifiers only; no password, express clusters use IAM tokens.
AURORA_HOST=
AURORA_PORT=5432
AURORA_DATABASE=postgres
AURORA_USER=rag_app
# Optional: a CA bundle file for the server certificate check. Empty uses botocore's.
AURORA_CA_BUNDLE=

# The DynamoDB table of the deployed daily cap (Cycle 2 step 7b). `call_api.py usage` and the deployed eval plan
# read it, which needs dynamodb:GetItem for the dev user.
USAGE_TABLE=

# Lambda (Cycle 2 step 4) sets these in the function's environment. Leave them unset locally.
# RAG_RUNS_DIR=/tmp/runs
# BEDROCK_MAX_ATTEMPTS=2
# RERANK_MIN_INTERVAL_S=0
# AURORA_CONNECT_ATTEMPTS=1
# AURORA_CONNECT_TIMEOUT_S=22
# AURORA_RETRY_PAUSE_S=5
# BEDROCK_CONNECT_TIMEOUT_S=5
# BEDROCK_READ_TIMEOUT_S=20
# API_DAILY_ASK_LIMIT=50
# DEMO_ENABLED=true
# Lambda sets AWS_LAMBDA_FUNCTION_NAME itself; it switches on the deployed error messages and cost lines.
