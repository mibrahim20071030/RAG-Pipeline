# Copy to .env and fill in. .env is gitignored.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGDATABASE=postgres
PGPASSWORD=

# Aurora (Cycle 2 step 1). Identifiers only; no password, express clusters use IAM tokens.
AURORA_HOST=
AURORA_PORT=5432
AURORA_DATABASE=postgres
AURORA_USER=rag_app
AURORA_CLUSTER_ARN=
AURORA_SECRET_ARN=
