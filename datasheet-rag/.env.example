# Copy to .env and fill in. .env is gitignored.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGDATABASE=postgres
PGPASSWORD=

# Which database the code uses: local or aurora. Leave it local here; set DB_TARGET=aurora in the shell
# for a command that should reach Aurora.
DB_TARGET=local

# Aurora (Cycle 2). Identifiers only; no password, express clusters use IAM tokens.
AURORA_HOST=
AURORA_PORT=5432
AURORA_DATABASE=postgres
AURORA_USER=rag_app
# Optional: a CA bundle file for the server certificate check. Empty uses botocore's.
AURORA_CA_BUNDLE=
