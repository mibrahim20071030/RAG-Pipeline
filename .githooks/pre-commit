#!/bin/sh
# Runs before every commit: secret scan, lint, tests. A failure stops the commit.
# Turn on once per clone:  git config core.hooksPath .githooks
# Skip once (not advised): git commit --no-verify

root="$(git rev-parse --show-toplevel)"
python="$root/datasheet-rag/.venv/Scripts/python.exe"
[ -x "$python" ] || python="$root/datasheet-rag/.venv/bin/python"

if [ ! -x "$python" ]; then
    echo "pre-commit: no virtual environment at datasheet-rag/.venv, so the checks cannot run."
    exit 1
fi

exec "$python" "$root/tools/checks.py" --staged
